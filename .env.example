# Kalshi API settings
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_REQUEST_TIMEOUT=20

# Target probability band (default: +200 to -150 American odds)
TARGET_MIN_AMERICAN=-150
TARGET_MAX_AMERICAN=200
TARGET_MIN_PROBABILITY=0.333333
TARGET_MAX_PROBABILITY=0.60

# Output directory for CSV boards
OUTPUT_DIR=./outputs
